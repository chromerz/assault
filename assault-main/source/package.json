{
  "name": "assault",
  "private": true,
  "version": "2.11.2",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsc && vite build",
    "lint": "tsc --noEmit",
    "start": "NODE_ENV=production tsx server.ts",
